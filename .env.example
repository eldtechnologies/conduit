# Conduit Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# Server Configuration
# ============================================
# development | production | test (production enforces HTTPS, see below)
NODE_ENV=development
PORT=3000
# debug | info | warn | error (case-insensitive). warn hides the per-request lines
LOG_LEVEL=info

# ============================================
# Phase 1: Email Provider (Resend)
# ============================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# API Keys (One per frontend application)
# ============================================
# Generate secure keys with: npm run generate-key -- APPNAME
# Format: KEY_<APPNAME>_<32-hex-characters>
# The example key below is public: replace it before deploying anywhere.
#
# Every API_KEY_* variable is validated at startup. The server refuses to start if:
# - an API_KEY_<NAME> value is not a valid key (KEY_<NAME>_<12+ letters/digits>)
# - an API_KEY_<NAME>_<SUFFIX> variable uses an unknown suffix (typos fail loudly)
# - a per-key variable refers to an API_KEY_<NAME> that is not set
# Supported per-key suffixes: _RECIPIENTS, _RECIPIENT_DOMAINS, _FROM_ADDRESSES,
# _LLM_ENABLED, _LLM_RULES, _LLM_THRESHOLD, _LLM_FAIL_MODE, _LLM_MAX_CALLS_PER_DAY
API_KEY_EXAMPLE=KEY_EXAMPLE_a8f9d2c1b4e6f7a9b8c7d6e5f4a3b2c1

# Add more API keys as needed (paste the output of npm run generate-key):
# API_KEY_MYSITE=<output of: npm run generate-key -- MYSITE>
# API_KEY_PORTFOLIO=<output of: npm run generate-key -- PORTFOLIO>

# ============================================
# Sender Allowlist (per API key, optional)
# ============================================
# Comma-separated `from` addresses this key may send as (case-insensitive).
# The first address is the default sender when the request omits `from`.
# Without an allowlist, a request that sets `from` is rejected with
# 400 SENDER_NOT_ALLOWED, and mail without `from` is sent as
# Conduit <onboarding@resend.dev> (Resend test sender, testing only).
# Empty lists or invalid addresses fail startup.
# API_KEY_EXAMPLE_FROM_ADDRESSES=noreply@mail.yoursite.com,support@mail.yoursite.com

# ============================================
# Recipient Whitelisting (per API key, optional)
# ============================================
# Restrict which `to` addresses a key can send to (stolen-key protection).
# If either variable is set, any other recipient is rejected with
# 403 RECIPIENT_NOT_ALLOWED. If neither is set, all recipients are allowed.
# An empty list or an invalid address/domain fails startup (domains: example.com,
# exact match, no @ or wildcard).
# API_KEY_EXAMPLE_RECIPIENTS=support@yoursite.com,admin@yoursite.com
# API_KEY_EXAMPLE_RECIPIENT_DOMAINS=yoursite.com

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins (NO wildcards in production)
# Include protocol, no trailing slash
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3001

# Production example:
# ALLOWED_ORIGINS=https://yoursite.com,https://www.yoursite.com,https://app.yoursite.com

# ============================================
# Rate Limiting (per API key)
# ============================================
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=100
RATE_LIMIT_PER_DAY=500

# ============================================
# Security (Optional)
# ============================================
# Revoked API keys (comma-separated)
# REVOKED_KEYS=KEY_OLD_xxxxx,KEY_COMPROMISED_xxxxx

# HTTPS enforcement (requires X-Forwarded-Proto: https on all non-/health routes)
# - NODE_ENV=production ALWAYS enforces HTTPS; this flag cannot turn it off.
# - ENFORCE_HTTPS=true additionally enforces it outside production (e.g. staging).
# - For a local plain-HTTP run (including Docker), use NODE_ENV=development.
ENFORCE_HTTPS=false

# ============================================
# LLM Spam Filtering (Optional)
# ============================================
# Global provider settings. Filtering is active only when LLM_PROVIDER,
# LLM_API_KEY and LLM_MODEL are all set. If any API key sets
# _LLM_ENABLED=true while one of them is missing, startup fails.
# Only anthropic and openai are supported.
# Recommended (tested): Claude Haiku 5.5 through OpenRouter
# LLM_PROVIDER=openai
# LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=anthropic/claude-haiku-5.5
# Or direct Anthropic:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-haiku-4-5-20251001
# Provider request timeout in milliseconds (default: 5000)
# LLM_TIMEOUT=5000
# Default fail mode for keys without _LLM_FAIL_MODE: allow | block (default: allow)
# LLM_FALLBACK_MODE=allow
# Optional custom provider endpoint (regional/proxy URL; set above for OpenRouter)

# Per API key settings (filtering is off for a key unless _LLM_ENABLED=true):
# API_KEY_EXAMPLE_LLM_ENABLED=true
# Categories to check: spam, abuse, profanity, promptInjection, phishing, scam
# (default: all except profanity)
# API_KEY_EXAMPLE_LLM_RULES=spam,abuse,phishing,scam,promptInjection
# Block when the model's confidence is at least this value, 0-1 (default: 0.7).
# Values outside 0-1 (e.g. 70) fail startup.
# API_KEY_EXAMPLE_LLM_THRESHOLD=0.7
# On provider errors or exhausted budget: allow (fail open) or block (503)
# (default: LLM_FALLBACK_MODE)
# API_KEY_EXAMPLE_LLM_FAIL_MODE=block
# Maximum LLM calls per day for this key, resets at midnight UTC (default: 1000).
# Must be a positive integer.
# API_KEY_EXAMPLE_LLM_MAX_CALLS_PER_DAY=1000

# ============================================
# Future Phases (NOT IMPLEMENTED - the code does not read these yet)
# ============================================
# SMS (Twilio), push (Firebase) and webhooks (Slack) are planned. No
# variables are needed or read for them today.
